{
  "name": "ng-nordpool",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-env.js",
    "start": "ng serve",
    "predev": "node scripts/generate-env.js",
    "dev": "ng serve --port 3000",
    "pretest": "node scripts/generate-env.js",
    "prebuild": "node scripts/generate-env.js && node -e \"const fs=require('fs');fs.writeFileSync('src/environments/build-info.ts','export const BUILD_DATE = \\\"'+new Date().toISOString()+'\\\";\\n');\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/entity": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
